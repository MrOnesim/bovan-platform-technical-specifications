DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bovan
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adresse affichée en secours si l'envoi du formulaire échoue.
# Les demandes sont désormais enregistrées en base (table inquiries) ; cette
# adresse n'est plus le canal principal.
NEXT_PUBLIC_OCD_CONTACT_EMAIL=

# Notification email des demandes de réservation (optionnel, via Resend).
# Si absents, les demandes sont tout de même enregistrées en base.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=

# Identifiant du projet Unicorn Studio utilisé par le composant energy-beam (optionnel).
NEXT_PUBLIC_UNICORN_PROJECT_ID=

# V1 marketplace (talents, entreprises, offres, messagerie, avis).
# Désactivée par défaut : ses routes API répondent 410. Passer à true pour rouvrir.
V1_MARKETPLACE_ENABLED=false

# Uploads (optionnel). Si absent, les fichiers sont enregistrés dans public/uploads.
# Compatible S3, MinIO, Cloudflare R2, Backblaze B2, etc.
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=ocd-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://cdn.example.com
# S3_FORCE_PATH_STYLE=false
